# QuizMaster Environment Variables

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Configuration (PostgreSQL)
# When configured, QuizMaster connects to live Supabase Auth and PostgreSQL.
# When left with defaults, QuizMaster uses the permanent local database engine with zero data loss.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI Question Generation (Google Gemini)
GEMINI_API_KEY=""

# SMS Provider Configuration
# Set to "twilio", "fast2sms", "msg91", or "development"
SMS_PROVIDER="development"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="QZMSTR"
MSG91_TEMPLATE_ID=""

# Cron & Scheduler Security
CRON_SECRET="quizmaster-secure-cron-token-2026"

# Admin Master Key for secure administrative bootstrapping
ADMIN_SECRET_KEY="quizmaster-admin-secret-2026"
